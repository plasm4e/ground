{
  "name": "ground",
  "private": true,
  "version": "0.1.0",
  "description": "Capture paper documents with your phone, extract the useful bits and keep them organized by what matters to you.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @ground/mobile",
    "server": "npm run dev -w @ground/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "EXPO_PUBLIC_SAME_ORIGIN=1 npm run export:web -w @ground/mobile",
    "start": "npm run start -w @ground/server",
    "build:web:static": "npm run export:web -w @ground/mobile"
  },
  "engines": {
    "node": ">=22.13"
  }
}
