# Port the API listens on.
PORT=4000
# SQLite file. Created on first start.
GROUND_DB_PATH=./ground.db
# Optional shared secret. When set, every /api request must send "Authorization: Bearer <token>".
# Strongly recommended: Ground stores personal information.
GROUND_API_TOKEN=
# Enables AI extraction (POST /api/extract). Without it the app falls back to its offline parser.
ANTHROPIC_API_KEY=
# Model used for extraction.
GROUND_MODEL=claude-opus-5-5
